<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) draws its own splash screen before Flutter starts. It
     cannot be disabled, so the icon is replaced with a transparent drawable and
     the background matched to the brand slate. The first frame is then already
     the same colour as SplashScreen, making the handoff invisible. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>
</resources>
