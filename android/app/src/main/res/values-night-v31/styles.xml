<?xml version="1.0" encoding="utf-8"?>
<!-- Night-mode qualifier outranks the platform-version qualifier in Android's
     resource precedence, so values-night/styles.xml would otherwise win over
     values-v31/styles.xml on an API 31+ device in dark mode and the launcher
     icon would reappear. This file keeps the two in sync. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>
</resources>
